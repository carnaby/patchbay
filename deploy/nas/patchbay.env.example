# Copy to patchbay.env. Passed to the Patchbay container only.
# PUBLIC_URL, TRUST_PROXY and PIPELINE_WORKERS are set in docker-compose.yml, UMAMI_* in .env.

# Google sign-in (https://console.cloud.google.com/apis/credentials), OAuth client of type "Web application":
#   Authorized JavaScript origin: https://dash.example.com
#   Authorized redirect URI:      https://dash.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get the admin page.
ADMIN_EMAILS=

# Never on a public deployment (the server refuses it anyway when NODE_ENV=production).
DEV_LOGIN=0

# Delete anonymous dashboards nobody opened for N days (0 = keep forever).
PRUNE_ANONYMOUS_AFTER_DAYS=60

# Credentials for HTTP data sources: off (default), admins or users. Anything but off needs SECRETS_KEY
# (32 random bytes, `openssl rand -base64 32`). Do not back up this file together with the data directory:
# the two together can decrypt every stored secret.
SECRETS=off
SECRETS_KEY=
