# Copy to .env next to docker-compose.yml. Compose reads this file for the variables in
# docker-compose.yml; the app itself only sees patchbay.env (so the tunnel token stays out of it).

# Owner of ./data. On Synology the first user created is usually 1026:100 (check with `id` over SSH).
PUID=1026
PGID=100

# Public hostname configured on the tunnel, without scheme. PUBLIC_URL becomes https://<this>.
PATCHBAY_DOMAIN=dash.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
TUNNEL_TOKEN=

# Image tag. `latest` follows main; set a commit SHA to pin or roll back.
PATCHBAY_TAG=latest
