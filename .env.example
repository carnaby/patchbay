# Copy to .env. Every variable is optional for local development.

# Public origin of the app. In development this is the Vite dev server,
# because the browser talks to the API through Vite's proxy.
PUBLIC_URL=http://localhost:5173
PORT=8787

# Where dashboard folders and the SQLite index live.
DATA_DIR=./data

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get the admin page.
ADMIN_EMAILS=

# Development only: sign in as any email without Google. Refused when NODE_ENV=production.
DEV_LOGIN=1

# Serve synthetic data instead of calling public APIs (offline work, CI, demos).
OFFLINE=0

# Delete anonymous dashboards nobody opened for N days (0 = keep forever).
PRUNE_ANONYMOUS_AFTER_DAYS=0

# Which client IP rate limits use. 0: the connecting socket (no proxy in front).
# 1: the right-most X-Forwarded-For entry (behind your own reverse proxy, e.g. Caddy).
# cloudflare: CF-Connecting-IP. Only when every request arrives through Cloudflare (e.g. a Cloudflare
# Tunnel with no published port); anywhere else clients can forge that header.
TRUST_PROXY=0

# Worker threads for data processing (default: CPUs - 1, max 4). 0 = process on the main thread.
# PIPELINE_WORKERS=
# Hard time limit for one pipeline run in a worker, in milliseconds.
# PIPELINE_TIMEOUT_MS=10000

# Credentials for HTTP data sources ("secrets", see docs/proposals/0003-source-secrets.md).
# off: nobody can store them (default). admins: only ADMIN_EMAILS. users: every signed-in user.
# Whoever runs the server can technically read stored secrets; only turn this on if you accept that responsibility.
SECRETS=off
# Required unless SECRETS=off: 32 random bytes in base64. Generate with `openssl rand -base64 32`, or
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the backups of DATA_DIR: a backup that holds both can decrypt every secret. Losing it only
# means users have to enter their secrets again.
SECRETS_KEY=
# Rotation: put the new key in SECRETS_KEY and the old one(s) here (comma-separated), restart once, then remove.
SECRETS_KEY_PREVIOUS=
