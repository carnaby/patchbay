# Copy to .env. Every variable is optional for local development.

# Public origin of the app. In development this is the Vite dev server,
# because the browser talks to the API through Vite's proxy.
PUBLIC_URL=http://localhost:5173
PORT=8787

# Where dashboard folders and the SQLite index live.
DATA_DIR=./data

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get the admin page.
ADMIN_EMAILS=

# Development only: sign in as any email without Google. Refused when NODE_ENV=production.
DEV_LOGIN=1

# Serve synthetic data instead of calling public APIs (offline work, CI, demos).
OFFLINE=0

# Delete anonymous dashboards nobody opened for N days (0 = keep forever).
PRUNE_ANONYMOUS_AFTER_DAYS=0
# Delete anonymous dashboards that are still blank (never edited) N hours after creation (0 = keep).
PRUNE_BLANK_ANONYMOUS_AFTER_HOURS=0
# Disk space all anonymous dashboards together may take, in MB (default 1024, 0 = no limit). Above it, nobody
# can create or grow anonymous dashboards until space is freed; signed-in users are not affected.
ANONYMOUS_STORAGE_LIMIT_MB=1024
# Disk space one signed-in user's dashboards may take, in MB (default 500, 0 = no limit). Above it, that user can
# edit, shrink and delete but not create or grow dashboards, upload, copy or claim. Administrators are not limited.
USER_STORAGE_LIMIT_MB=500

# Which client IP rate limits use. 0: the connecting socket (no proxy in front).
# 1: the right-most X-Forwarded-For entry (behind your own reverse proxy, e.g. Caddy).
# cloudflare: CF-Connecting-IP. Only when every request arrives through Cloudflare (e.g. a Cloudflare
# Tunnel with no published port); anywhere else clients can forge that header.
TRUST_PROXY=0

# Worker threads for data processing (default: CPUs - 1, max 4). 0 = process on the main thread.
# PIPELINE_WORKERS=
# Hard time limit for one pipeline run in a worker, in milliseconds.
# PIPELINE_TIMEOUT_MS=10000
# Heap limit of each worker in MB. A job that needs more fails (and its worker is replaced) instead of
# exhausting the machine. Keep workers x this well below the container's memory limit.
# PIPELINE_WORKER_MEMORY_MB=96

# Uploads are limited in cells (rows x columns), because memory follows cells, not file size: a 5 MB CSV of
# one-digit values is two million cells. Dashboards with an owner / anonymous dashboards. The first also caps
# how much of an HTTP response is kept.
# UPLOAD_MAX_CELLS=500000
# UPLOAD_MAX_CELLS_ANONYMOUS=200000
# Memory for parsed tables kept between requests (uploads, inline rows, HTTP responses), in MB.
# DATA_CACHE_MB=32

# Memory guard: the server measures its container's memory use (cgroup) against the container's limit. Above the
# soft share it refuses new heavy work (snapshots, uploads, large pipelines and results) with 503 + Retry-After;
# above the hard share also writes, MCP calls and new live streams. Work already running always finishes.
# MEMORY_LIMIT_MB overrides the detected limit; without a container limit (a dev machine) the guard is off unless
# it is set, and then compares the process's own memory with it. 0 turns the guard off.
# The shares default to 0.8 and 0.9, lowered on small limits so that 128 MB and 64 MB stay free above them
# (256 MB and 320 MB of a 384 MB container).
# MEMORY_LIMIT_MB=
# MEMORY_SOFT_FRACTION=0.8
# MEMORY_HARD_FRACTION=0.9

# Who may make this server fetch URLs (http and feed sources). everyone (default): any dashboard.
# signed-in: only dashboards owned by a signed-in user. Use signed-in on a public instance that runs on a
# connection you care about, so strangers cannot use it to fetch arbitrary addresses from your IP.
URL_SOURCES=everyone

# Credentials for HTTP data sources ("secrets", see guide/deployment.md).
# off: nobody can store them (default). admins: only ADMIN_EMAILS. users: every signed-in user.
# Whoever runs the server can technically read stored secrets; only turn this on if you accept that responsibility.
SECRETS=off
# Required unless SECRETS=off: 32 random bytes in base64. Generate with `openssl rand -base64 32`, or
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the backups of DATA_DIR: a backup that holds both can decrypt every secret. Losing it only
# means users have to enter their secrets again.
SECRETS_KEY=
# Rotation: put the new key in SECRETS_KEY and the old one(s) here (comma-separated), restart once, then remove.
SECRETS_KEY_PREVIOUS=

# Optional page-view analytics with Umami (https://umami.is): cookieless, and configured to send no query strings,
# no fragments, no dashboard IDs and nothing at all when the browser sends Do Not Track. Off unless both are set;
# with neither set, no tracker is loaded. Setting only one is a startup error.
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_WEBSITE_ID=
