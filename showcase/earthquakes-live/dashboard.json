{
  "schemaVersion": 1,
  "title": "Earthquakes this week",
  "description": "Every M2.5+ earthquake of the past 7 days from the USGS feed: where they hit, the strongest ones, and which regions shook most.",
  "datasets": [
    {
      "id": "quakes",
      "name": "Earthquakes, past 7 days",
      "source": {
        "kind": "connector",
        "connector": "earthquakes",
        "params": {
          "period": "week",
          "minMagnitude": "2.5"
        }
      },
      "transforms": [
        {
          "id": "newest",
          "type": "sort",
          "by": [
            {
              "field": "time",
              "dir": "desc"
            }
          ]
        }
      ],
      "refreshSec": 300,
      "accumulate": 0
    },
    {
      "id": "strongest",
      "name": "Strongest quakes",
      "source": {
        "kind": "connector",
        "connector": "earthquakes",
        "params": {
          "period": "week",
          "minMagnitude": "2.5"
        }
      },
      "transforms": [
        {
          "id": "bymag",
          "type": "sort",
          "by": [
            {
              "field": "magnitude",
              "dir": "desc"
            }
          ]
        },
        {
          "id": "top",
          "type": "limit",
          "n": 8,
          "from": "start"
        },
        {
          "id": "cols",
          "type": "select",
          "fields": ["magnitude", "place", "time", "depth_km", "url"]
        }
      ],
      "refreshSec": 300,
      "accumulate": 0
    },
    {
      "id": "daily",
      "name": "Quakes per day",
      "source": {
        "kind": "connector",
        "connector": "earthquakes",
        "params": {
          "period": "week",
          "minMagnitude": "2.5"
        }
      },
      "transforms": [
        {
          "id": "day",
          "type": "timeBucket",
          "field": "time",
          "unit": "day",
          "as": "day",
          "dropPartial": true
        },
        {
          "id": "count",
          "type": "aggregate",
          "groupBy": ["day"],
          "metrics": [
            {
              "op": "count",
              "as": "quakes"
            }
          ]
        },
        {
          "id": "order",
          "type": "sort",
          "by": [
            {
              "field": "day",
              "dir": "asc"
            }
          ]
        }
      ],
      "refreshSec": 300,
      "accumulate": 0
    },
    {
      "id": "regions",
      "name": "Most active regions",
      "source": {
        "kind": "connector",
        "connector": "earthquakes",
        "params": {
          "period": "week",
          "minMagnitude": "2.5"
        }
      },
      "transforms": [
        {
          "id": "count",
          "type": "aggregate",
          "groupBy": ["region"],
          "metrics": [
            {
              "op": "count",
              "as": "quakes"
            }
          ]
        },
        {
          "id": "order",
          "type": "sort",
          "by": [
            {
              "field": "quakes",
              "dir": "desc"
            }
          ]
        },
        {
          "id": "top",
          "type": "limit",
          "n": 10,
          "from": "start"
        }
      ],
      "refreshSec": 300,
      "accumulate": 0
    }
  ],
  "widgets": [
    {
      "id": "total",
      "title": "Quakes this week",
      "datasetId": "quakes",
      "type": "kpi",
      "config": {
        "agg": "count",
        "compare": "none",
        "goodWhen": "up",
        "sparkline": false
      }
    },
    {
      "id": "maxmag",
      "title": "Strongest",
      "datasetId": "quakes",
      "type": "kpi",
      "config": {
        "field": "magnitude",
        "agg": "max",
        "compare": "none",
        "goodWhen": "up",
        "sparkline": false,
        "format": {
          "style": "number",
          "decimals": 1,
          "prefix": "M"
        }
      }
    },
    {
      "id": "perday",
      "title": "Quakes per day",
      "datasetId": "daily",
      "type": "chart",
      "config": {
        "kind": "bar",
        "x": "day",
        "y": ["quakes"],
        "horizontal": false,
        "stacked": false,
        "smooth": false,
        "showLabels": true,
        "logScale": false,
        "maxPoints": 5000
      }
    },
    {
      "id": "map",
      "title": "Where, sized by magnitude",
      "datasetId": "quakes",
      "type": "map",
      "config": {
        "lat": "latitude",
        "lon": "longitude",
        "mode": "points",
        "size": "magnitude",
        "label": "place",
        "view": "world",
        "basemap": "countries",
        "terminator": false,
        "maxPoints": 5000
      }
    },
    {
      "id": "regions",
      "title": "Most active regions",
      "datasetId": "regions",
      "type": "chart",
      "config": {
        "kind": "bar",
        "x": "region",
        "y": ["quakes"],
        "horizontal": true,
        "stacked": false,
        "smooth": false,
        "showLabels": true,
        "logScale": false,
        "maxPoints": 5000
      }
    },
    {
      "id": "top",
      "title": "Strongest this week",
      "datasetId": "strongest",
      "type": "table",
      "config": {
        "columns": [
          {
            "field": "magnitude",
            "label": "Mag",
            "format": {
              "style": "number",
              "decimals": 1
            },
            "bands": [
              {
                "upTo": 5.9,
                "color": "serious"
              },
              {
                "upTo": 10,
                "color": "negative"
              }
            ],
            "colorAs": "text"
          },
          {
            "field": "place",
            "label": "Where",
            "link": "url",
            "colorAs": "fill"
          },
          {
            "field": "time",
            "label": "When",
            "colorAs": "fill"
          },
          {
            "field": "depth_km",
            "label": "Depth (km)",
            "format": {
              "style": "number",
              "decimals": 0
            },
            "colorAs": "fill"
          }
        ],
        "pageSize": 8
      }
    }
  ],
  "layout": [
    {
      "i": "total",
      "x": 0,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "maxmag",
      "x": 3,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "i": "perday",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5
    },
    {
      "i": "map",
      "x": 0,
      "y": 2,
      "w": 6,
      "h": 7
    },
    {
      "i": "regions",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 4
    },
    {
      "i": "top",
      "x": 0,
      "y": 9,
      "w": 12,
      "h": 4
    }
  ]
}
