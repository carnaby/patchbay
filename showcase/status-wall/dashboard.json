    },
    {
      "id": "oai-comp",
      "name": "OpenAI components",
      "source": {
        "kind": "http",
        "url": "https://status.openai.com/api/v2/components.json",
        "path": "components"
      },
      "transforms": [
        {
          "id": "s1",
          "type": "derive",
          "as": "service",
          "expr": "\"OpenAI\""
        },
        {
          "id": "s2",
          "type": "derive",
          "as": "check",
