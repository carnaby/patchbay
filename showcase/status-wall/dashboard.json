        },
        {
          "id": "s3",
          "type": "derive",
          "as": "check",
          "expr": "name"
        },
        {
          "id": "s4",
          "type": "derive",
          "as": "kind",
          "expr": "\"component\""
        },
        {
          "id": "s5",
          "type": "derive",
          "as": "state",
          "expr": "status == \"operational\" ? \"ok\" : (status == \"major_outage\" ? \"fail\" : (status == \"under_maintenance\" ? \"off\" : \"warn\"))"
        },
        {
          "id": "s6",
          "type": "derive",
          "as": "detail",
          "expr": "status == \"degraded_performance\" ? \"Degraded performance\" : (status == \"partial_outage\" ? \"Partial outage\" : (status == \"major_outage\" ? \"Major outage\" : (status == \"under_maintenance\" ? \"Under maintenance\" : status)))"
        },
        {
          "id": "s7",
          "type": "derive",
          "as": "since",
          "expr": "updated_at"
        },
        {
          "id": "s8",
          "type": "derive",
          "as": "link",
          "expr": "\"https://status.npmjs.org\""
        },
        {
          "id": "s9",
          "type": "select",
          "fields": ["service", "check", "kind", "state", "detail", "since", "link"]
        }
      ],
      "refreshSec": 60,
      "accumulate": 0
    },
    {
      "id": "npm",
      "name": "npm checks",
      "source": {
        "kind": "dataset",
        "id": "npm-comp"
      },
      "transforms": [
        {
          "id": "s1",
          "type": "union",
