    {
      "id": "oai",
      "name": "OpenAI checks",
      "source": {
        "kind": "dataset",
        "id": "oai-comp"
      },
      "transforms": [
        {
          "id": "s1",
          "type": "union",
          "with": ["oai-inc"]
        },
        {
