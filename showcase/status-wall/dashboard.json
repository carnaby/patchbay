            }
          ]
        }
      ],
      "refreshSec": 0,
      "accumulate": 0
    },
    {
      "id": "oai-inc",
      "name": "OpenAI open incidents",
      "source": {
        "kind": "http",
        "url": "https://status.openai.com/api/v2/incidents.json",
        "path": "incidents"
      },
      "transforms": [
        {
          "id": "s1",
          "type": "filter",
          "expr": "status != \"resolved\" && status != \"postmortem\" && status != \"completed\""
        },
        {
          "id": "s2",
