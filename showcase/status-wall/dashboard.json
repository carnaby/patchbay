    {
      "id": "gh-history",
      "name": "GitHub incident history",
      "source": {
        "kind": "feed",
        "url": "https://www.githubstatus.com/history.atom",
        "limit": 8
      },
      "transforms": [
        {
          "id": "s1",
          "type": "derive",
          "as": "head",
          "expr": "substr(summary, 0, 40)"
        },
        {
          "id": "s2",
          "type": "derive",
          "as": "state",
          "expr": "contains(head, \"Resolved\") ? \"Resolved\" : (contains(head, \"Monitoring\") ? \"Monitoring\" : (contains(head, \"Identified\") ? \"Identified\" : (contains(head, \"Investigating\") ? \"Investigating\" : \"Ongoing\")))"
        },
        {
          "id": "s3",
          "type": "limit",
          "n": 5,
          "from": "start"
        },
        {
          "id": "s4",
          "type": "select",
          "fields": ["id", "title", "link", "state", "published"]
        }
      ],
      "refreshSec": 300,
      "accumulate": 0
    }
  ],
  "widgets": [
    {
      "id": "clock",
      "type": "clock",
      "config": {
        "style": "digital",
        "hourCycle": "h23",
        "showDate": true,
        "showSeconds": false
      }
    },
    {
      "id": "st-gh",
      "title": "GitHub",
      "datasetId": "gh",
      "type": "status",
      "config": {
        "entity": "check",
        "status": "state",
        "label": "label",
        "kind": "kind",
        "detail": "detail",
        "since": "since",
        "link": "link",
        "summary": true
      }
    },
    {
      "id": "st-cf",
      "title": "Cloudflare",
      "datasetId": "cf",
      "type": "status",
      "config": {
        "entity": "check",
        "status": "state",
        "label": "label",
        "kind": "kind",
        "detail": "detail",
        "since": "since",
        "link": "link",
        "summary": true
      }
    },
    {
      "id": "st-npm",
      "title": "npm",
      "datasetId": "npm",
      "type": "status",
      "config": {
        "entity": "check",
        "status": "state",
        "label": "label",
        "kind": "kind",
        "detail": "detail",
        "since": "since",
        "link": "link",
        "summary": true
      }
    },
    {
      "id": "st-oai",
      "title": "OpenAI",
      "datasetId": "oai",
      "type": "status",
      "config": {
        "entity": "check",
        "status": "state",
        "label": "label",
        "kind": "kind",
        "detail": "detail",
        "since": "since",
        "link": "link",
        "summary": true
      }
    },
    {
      "id": "gh-incidents",
      "title": "Latest GitHub incident reports",
      "datasetId": "gh-history",
      "type": "table",
      "config": {
        "columns": [
          {
            "field": "title",
            "link": "link",
            "colorAs": "fill"
          },
          "state",
          "published"
        ],
        "pageSize": 5,
        "rules": [
          {
            "when": "state != \"Resolved\"",
            "color": "warning",
            "colorAs": "fill",
            "label": "still open"
          }
        ],
        "style": "list"
      }
    }
  ],
  "layout": [
    {
      "i": "st-gh",
      "x": 0,
      "y": 0,
      "w": 3,
      "h": 5
    },
    {
      "i": "st-cf",
      "x": 3,
      "y": 0,
      "w": 3,
      "h": 5
    },
    {
      "i": "st-npm",
      "x": 6,
      "y": 0,
      "w": 3,
      "h": 5
    },
    {
      "i": "st-oai",
      "x": 9,
      "y": 0,
      "w": 3,
      "h": 5
