        },
        {
          "id": "s5",
          "type": "derive",
          "as": "detail",
          "expr": "name"
        },
        {
          "id": "s6",
          "type": "derive",
          "as": "since",
          "expr": "created_at"
        },
        {
          "id": "s7",
          "type": "derive",
          "as": "link",
          "expr": "shortlink"
        },
        {
          "id": "lbl",
          "type": "derive",
          "as": "label",
          "expr": "concat(status, \" · \", impact, \" impact\")"
        },
        {
          "id": "s8",
          "type": "select",
          "fields": ["service", "check", "label", "state", "detail", "since", "link"]
        }
      ],
      "refreshSec": 60,
      "accumulate": 0
    },
    {
      "id": "npm-comp",
      "name": "npm components",
      "source": {
        "kind": "http",
        "url": "https://status.npmjs.org/api/v2/components.json",
        "path": "components"
      },
      "transforms": [
