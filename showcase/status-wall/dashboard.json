        },
        {
          "id": "s4",
          "type": "derive",
          "as": "state",
          "expr": "status == \"operational\" ? \"ok\" : (status == \"major_outage\" ? \"fail\" : (status == \"under_maintenance\" ? \"off\" : \"warn\"))"
        },
        {
          "id": "s5",
          "type": "derive",
          "as": "detail",
